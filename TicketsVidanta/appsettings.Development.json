{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TicketsVidanta": "Server=.\\SQLEXPRESS;Database=TicketsVidanta;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True"
  },
  "Database": {
    "UseSqlPersistence": true,
    "ConnectionStringName": "TicketsVidanta"
  },
  "Processing": {
    "EnableBackgroundProcessing": true,
    "IntervalSeconds": 60,
    "BatchSize": 10,
    "MaxAttempts": 3,
    "ClaimLeaseSeconds": 300
  },
  "FinancialTransactionSource": {
  "Enabled": true,
  "LookbackDays": 7,
  "IntervalSeconds": 60
},
  "OperaCloud": {
    "UseMock": false,
    "EnableUpload": false
  },
  "DatabaseConfiguration": {
    "EnableAdminUi": true,
    "KeyRingDirectory": "App_Data/data-protection-keys"
  },
  "TicketGeneration": {
    "UseMock": false
  },
  "SyncEngine": {
  "Enabled": true,
  "DefaultIntervalSeconds": 180,
  "MaxConcurrentSyncs": 1
}
}
