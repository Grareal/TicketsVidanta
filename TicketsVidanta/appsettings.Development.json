{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TicketsVidanta": "Server=.\\SQLEXPRESS;Database=TicketsVidanta;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True"
  },
  "Database": {
    "UseSqlPersistence": true,
    "ConnectionStringName": "TicketsVidanta"
  },
  "Processing": {
    "EnableBackgroundProcessing": true,
    "IntervalSeconds": 60,
    "BatchSize": 10,
    "MaxAttempts": 3,
    "ClaimLeaseSeconds": 300
  },
  "OperaCloud": {
    "UseMock": true,
    "EnableUpload": false
  },
  "TicketGeneration": {
    "UseMock": false
  }
}
