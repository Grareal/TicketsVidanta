{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TicketsVidanta": "",
    "FinancialTransactions": "",
    "InssistNuevoVallarta": ""
  },
  "Database": {
    "UseSqlPersistence": false,
    "ConnectionStringName": "TicketsVidanta"
  },
   "Processing": {
  "EnableBackgroundProcessing": true,
  "IntervalSeconds": 5,
  "BatchSize": 50,
  "MaxAttempts": 1,
  "ClaimLeaseSeconds": 60
  },
  "DatabaseConfiguration": {
    "EnableAdminUi": false,
    "KeyRingDirectory": "App_Data/data-protection-keys"
  },
  "FinancialTransactionSource": {
    "Enabled": true,
    "ConnectionStringName": "FinancialTransactions",
    "Schema": "dbo",
    "Table": "FINANCIAL_TRANSACTIONS_P_DET_CLOUD",
    "ResortColumn": "RESORT",
    "TransactionDateColumn": "TRX_DATE",
    "BusinessDateColumn": "BUSINESS_DATE",
    "TransactionNumberColumn": "TRX_NO",
    "TcGroupColumn": "TC_GROUP",
    "TcSubGroupColumn": "TC_SUBGROUP",
    "TrxCodeColumn": "TRX_CODE",
    "CheckNumberColumn": "CHEQUE_NUMBER",
    "ReservationIdColumn": "RESV_NAME_ID",
    "RoomColumn": "ROOM",
    "ReferenceColumn": "REFERENCE",
    "RemarkColumn": "REMARK",
    "BatchSize": 1000,
    "LookbackDays": 7,
    "IntervalSeconds": 60
  },
  "OperaCloud": {
    "UseMock": false,
    "EnableUpload": false,
    "GatewayUrl": "",
    "TokenPath": "/oauth/v1/tokens",
    "GrantType": "client_credentials",
    "AppKey": "",
    "ClientId": "",
    "ClientSecret": "",
    "EnterpriseId": "",
    "Scope": "",
    "Username": "",
    "Password": "",
    "DefaultResort": "VINV",
    "HotelIdsByResort": {
      "VINV": "",
      "VILC": "",
      "VIAC": "",
      "VIMZ": ""
    },
    "HotelId": "",
    "ExternalSystemCode": "",
    "TimeoutSeconds": 30
  },
  "TicketGeneration": {
    "UseMock": false,
    "MimeType": "image/svg+xml",
    "OutputDirectory": "App_Data/generated-tickets"
  }
   
}
