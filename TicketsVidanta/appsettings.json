{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TicketsVidanta": "",
    "FinancialTransactions": "",
    "InssistNuevoVallarta": ""
  },
  "Database": {
    "UseSqlPersistence": false,
    "ConnectionStringName": "TicketsVidanta"
  },
  "Processing": {
    "EnableBackgroundProcessing": false,
    "IntervalSeconds": 60,
    "BatchSize": 10,
    "MaxAttempts": 3,
    "ClaimLeaseSeconds": 300
  },
  "DatabaseConfiguration": {
    "EnableAdminUi": false,
    "KeyRingDirectory": "App_Data/data-protection-keys"
  },
  "FinancialTransactionSource": {
    "Enabled": false,
    "ConnectionStringName": "FinancialTransactions",
    "BatchSize": 1000,
    "LookbackDays": 7,
    "IntervalSeconds": 60
  },
  "OperaCloud": {
    "UseMock": true,
    "EnableUpload": false,
    "GatewayUrl": "",
    "TokenPath": "/oauth/v1/tokens",
    "GrantType": "client_credentials",
    "AppKey": "",
    "ClientId": "",
    "ClientSecret": "",
    "EnterpriseId": "",
    "Scope": "",
    "Username": "",
    "Password": "",
    "HotelId": "",
    "ExternalSystemCode": "",
    "AttachmentUserName": "",
    "AttachmentDescription": "Ticket de consumo",
    "TimeoutSeconds": 30
  },
  "TicketGeneration": {
    "UseMock": false,
    "MimeType": "image/svg+xml",
    "OutputDirectory": "App_Data/generated-tickets"
  },
  "CommerceDatabases": {
    "Connections": {
      "INSSIST_SPA:NUEVO_VALLARTA": {
        "Provider": "SqlServer",
        "ConnectionStringName": "InssistNuevoVallarta"
      },
      "INSSIST_KIDSCLUB:NUEVO_VALLARTA": {
        "Provider": "SqlServer",
        "ConnectionStringName": "InssistNuevoVallarta"
      }
    }
  },
  "TransactionRouting": {
    "Rules": [
      {
        "TcGroup": "6OTROS",
        "TrxCode": "6",
        "SourceSystem": "INSSIST_SPA"
      },
      {
        "TcGroup": "6OTROS",
        "TrxCode": "4",
        "SourceSystem": "INSSIST_KIDSCLUB"
      }
    ]
  }
}
